<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_visibility" targetNamespace="https://github.com/erdembircan/claude-usage-band">
<bpmn:process id="Process_visibility" name="Is the usage band shown?" isExecutable="false"><bpmn:startEvent id="Start_draw" name="Band is about&#10;to be drawn"><bpmn:signalEventDefinition/></bpmn:startEvent><bpmn:exclusiveGateway id="Gw_surface" name="In the desktop app?"></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gw_survey" name="Is a Claude Code survey using the band?"></bpmn:exclusiveGateway><bpmn:dataStoreReference id="Store_limits" name="limits&#10;(session state)"></bpmn:dataStoreReference><bpmn:task id="Task_read" name="Take the stored limits; a window past its reset time counts as 0%"><bpmn:property id="Property_2" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="DataIn_1"><bpmn:sourceRef>Store_limits</bpmn:sourceRef><bpmn:targetRef>Property_2</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:task><bpmn:exclusiveGateway id="Gw_reading" name="Any session or weekly reading stored?"></bpmn:exclusiveGateway><bpmn:dataStoreReference id="Store_hidden" name="hidden&#10;(session state)"></bpmn:dataStoreReference><bpmn:task id="Task_hidden" name="Check the hidden flag"><bpmn:property id="Property_4" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="DataIn_3"><bpmn:sourceRef>Store_hidden</bpmn:sourceRef><bpmn:targetRef>Property_4</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:task><bpmn:exclusiveGateway id="Gw_hidden" name="Hidden by you?"></bpmn:exclusiveGateway><bpmn:task id="Task_build" name="Build the row: a mark and a percentage per window"></bpmn:task><bpmn:endEvent id="End_shown" name="Usage row shown"></bpmn:endEvent><bpmn:endEvent id="End_surface" name="Not shown"></bpmn:endEvent><bpmn:endEvent id="End_survey" name="Not shown"></bpmn:endEvent><bpmn:endEvent id="End_reading" name="Not shown"></bpmn:endEvent><bpmn:endEvent id="End_hidden" name="Not shown"></bpmn:endEvent><bpmn:sequenceFlow id="Flow_5" sourceRef="Start_draw" targetRef="Gw_surface"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Gw_surface" targetRef="Gw_survey" name="yes"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_surface" targetRef="End_surface" name="no"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_survey" targetRef="Task_read" name="no"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_survey" targetRef="End_survey" name="yes"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Task_read" targetRef="Gw_reading"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_reading" targetRef="Task_hidden" name="yes"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Gw_reading" targetRef="End_reading" name="no"/><bpmn:sequenceFlow id="Flow_13" sourceRef="Task_hidden" targetRef="Gw_hidden"/><bpmn:sequenceFlow id="Flow_14" sourceRef="Gw_hidden" targetRef="Task_build" name="no"/><bpmn:sequenceFlow id="Flow_15" sourceRef="Gw_hidden" targetRef="End_hidden" name="yes"/><bpmn:sequenceFlow id="Flow_16" sourceRef="Task_build" targetRef="End_shown"/><bpmn:textAnnotation id="Note_surface"><bpmn:text>The terminal and other apps never show it.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_17" sourceRef="End_surface" targetRef="Note_surface"/><bpmn:textAnnotation id="Note_survey"><bpmn:text>Comes back by itself when the survey closes.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_18" sourceRef="End_survey" targetRef="Note_survey"/><bpmn:textAnnotation id="Note_reading"><bpmn:text>No reading in two cases:
1. New session: Claude Code learns the limits from a reply, so nothing shows until the first message is answered.
2. The account has no plan limits.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_19" sourceRef="End_reading" targetRef="Note_reading"/><bpmn:textAnnotation id="Note_hidden"><bpmn:text>Until /usage-band is typed again, /clear, or a new session.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_20" sourceRef="End_hidden" targetRef="Note_hidden"/></bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_visibility"><bpmndi:BPMNPlane id="Plane_visibility" bpmnElement="Process_visibility"><bpmndi:BPMNShape id="Start_draw_di" bpmnElement="Start_draw"><dc:Bounds x="182" y="212" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="155" y="254" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_surface_di" bpmnElement="Gw_surface"><dc:Bounds x="315" y="205" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="270" y="150" width="140" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_survey_di" bpmnElement="Gw_survey"><dc:Bounds x="485" y="205" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="440" y="150" width="140" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Store_limits_di" bpmnElement="Store_limits"><dc:Bounds x="675" y="50" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="735" y="62" width="80" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DataIn_1_di" bpmnElement="DataIn_1"><di:waypoint x="700" y="100"/><di:waypoint x="700" y="190"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Task_read_di" bpmnElement="Task_read"><dc:Bounds x="615" y="190" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_reading_di" bpmnElement="Gw_reading"><dc:Bounds x="875" y="205" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="830" y="150" width="140" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Store_hidden_di" bpmnElement="Store_hidden"><dc:Bounds x="1045" y="50" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1105" y="62" width="80" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DataIn_3_di" bpmnElement="DataIn_3"><di:waypoint x="1070" y="100"/><di:waypoint x="1070" y="190"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Task_hidden_di" bpmnElement="Task_hidden"><dc:Bounds x="1005" y="190" width="130" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape