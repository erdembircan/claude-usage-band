<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_feed" targetNamespace="https://github.com/erdembircan/claude-usage-band">
<bpmn:collaboration id="Collaboration"><bpmn:participant id="Participant" name="Claude desktop session" processRef="Process_feed"/></bpmn:collaboration>
<bpmn:process id="Process_feed" name="Keeping the figures current" isExecutable="false"><bpmn:laneSet id="LaneSet"><bpmn:lane id="Lane_you" name="You"><bpmn:flowNodeRef>Start_toggle</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_engine" name="Claude Code"><bpmn:flowNodeRef>Start_session</bpmn:flowNodeRef><bpmn:flowNodeRef>Start_measure</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_mod" name="usage-band mod"><bpmn:flowNodeRef>Start_tick</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_toggle</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_measure</bpmn:flowNodeRef><bpmn:flowNodeRef>End_redraw</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:dataStoreReference id="Store_hidden" name="hidden&#10;(session state)"></bpmn:dataStoreReference><bpmn:dataStoreReference id="Store_limits" name="limits&#10;(session state)"></bpmn:dataStoreReference><bpmn:startEvent id="Start_toggle" name="/usage-band&#10;typed"></bpmn:startEvent><bpmn:startEvent id="Start_session" name="Session starts,&#10;or /clear"></bpmn:startEvent><bpmn:startEvent id="Start_measure" name="Usage measured&#10;after a turn"><bpmn:messageEventDefinition/></bpmn:startEvent><bpmn:startEvent id="Start_tick" name="Every&#10;minute"><bpmn:timerEventDefinition/></bpmn:startEvent><bpmn:task id="Task_toggle" name="Flip hidden on or off"><bpmn:dataOutputAssociation id="DataOut_1"><bpmn:targetRef>Store_hidden</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task><bpmn:task id="Task_start" name="Add /usage-band and read the limits"><bpmn:dataOutputAssociation id="DataOut_2"><bpmn:targetRef>Store_limits</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task><bpmn:task id="Task_measure" name="Keep the reported limits"><bpmn:dataOutputAssociation id="DataOut_3"><bpmn:targetRef>Store_limits</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task><bpmn:endEvent id="End_redraw" name="Band is redrawn"><bpmn:signalEventDefinition/></bpmn:endEvent><bpmn:sequenceFlow id="Flow_4" sourceRef="Start_toggle" targetRef="Task_toggle"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_toggle" targetRef="End_redraw"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Start_session" targetRef="Task_start"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Task_start" targetRef="End_redraw"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Start_measure" targetRef="Task_measure"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Task_measure" targetRef="End_redraw"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Start_tick" targetRef="End_redraw"/></bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_feed"><bpmndi:BPMNPlane id="Plane_feed" bpmnElement="Collaboration"><bpmndi:BPMNShape id="Store_hidden_di" bpmnElement="Store_hidden"><dc:Bounds x="350" y="520" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Store_limits_di" bpmnElement="Store_limits"><dc:Bounds x="755" y="520" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_toggle_di" bpmnElement="Start_toggle"><dc:Bounds x="262" y="82" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="306" y="80" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_session_di" bpmnElement="Start_session"><dc:Bounds x="662" y="207" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="706" y="205" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_measure_di" bpmnElement="Start_measure"><dc:Bounds x="862" y="207" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="906" y="205" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_tick_di" bpmnElement="Start_tick"><dc:Bounds x="1062" y="317" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1106" y="315" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DataOut_1_di" bpmnElement="DataOut_1"><di:waypoint x="320" y="480"/><di:waypoint x="360" y="520"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Task_toggle_di" bpmnElement="Task_toggle"><dc:Bounds x="205" y="400" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DataOut_2_di" bpmnElement="DataOut_2"><di:waypoint x="720" y="480"/><di:waypoint x="765" y="520"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Task_start_di" bpmnElement="Task_start"><dc:Bounds x="605" y="400" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DataOut_3_di" bpmnElement="DataOut_3"><di:waypoint x="840" y="480"/><di:waypoint x="795" y="520"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Task_measure_di" bpmnElement="Task_measure"><dc:Bounds x="805" y="400" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_redraw_di" bpmnElement="End_redraw"><dc:Bounds x="1162" y="602" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1135" y="642" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="280" y="118"/><di:waypoint x="280" y="400"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="280" y="480"/><di:waypoint x="280" y="620"/><di:waypoint x="1162" y="620"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="680" y="243"/><di:waypoint x="680" y="400"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="680" y="480"/><di:waypoint x="680" y="620"/><di:waypoint x="1162" y="620"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="880" y="243"/><di:waypoint x="880" y="400"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="880" y="480"/><di:waypoint x="880" y="620"/><di:waypoint x="1162" y="620"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1080" y="353"/><di:waypoint x="1080" y="620"/><di:waypoint x="1162" y="620"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant" isHorizontal="true"><dc:Bounds x="150" y="40" width="1110" height="650"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_you_di" bpmnElement="Lane_you" isHorizontal="true"><dc:Bounds x="180" y="40" width="1080" height="120"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_engine_di" bpmnElement="Lane_engine" isHorizontal="true"><dc:Bounds x="180" y="160" width="1080" height="120"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_mod_di" bpmnElement="Lane_mod" isHorizontal="true"><dc:Bounds x="180" y="280" width="1080" height="410"/></bpmndi:BPMNShape></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
